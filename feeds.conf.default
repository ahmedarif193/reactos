# External source feeds checked out into submodules/ by scripts/feeds.
#
# Copy this file to feeds.conf to override it locally; feeds.conf is ignored by
# Git and takes precedence when present.
#
# Format, one feed per line:
#   src-git <name> <url>;<branch> [nested submodule paths, comma separated]
#
# <name> is the directory created under submodules/. The checkout tracks the
# branch head: scripts/feeds update fetches the branch and fast-forwards the
# working copy to it. Nested submodules are initialized shallowly, one level at
# a time; every path not listed here stays uninitialized, which is how FEX's
# multi-gigabyte prebuilt test-binary repositories are kept out of the tree.

src-git fex-arm64ec https://github.com/eotics-com/FEX.git;main-ros External/Catch2,External/Vulkan-Headers,External/drm-headers,External/fmt,External/jemalloc_glibc,External/range-v3,External/rpmalloc,External/tracy,External/unordered_dense,External/vixl,External/xxhash,External/zydis,External/zydis/dependencies/zycore,Source/Common/cpp-optparse

src-git mesa https://github.com/eotics-com/reactos-mesa.git;ros-dev
