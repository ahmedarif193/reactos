+bool DecodeReactOsArm64SyscallStub(uintptr_t Address, uint64_t* SyscallId) {
+  constexpr uint32_t MovzX8Mask = 0xFFE0001F;
+  constexpr uint32_t MovzX8 = 0xD2800008;
+  constexpr uint32_t SvcZero = 0xD4000001;
+  const auto* Code = reinterpret_cast<const uint32_t*>(Address);
