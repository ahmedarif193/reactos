@echo off
setlocal EnableExtensions
set S=%SystemRoot%\system32
set GALLIUM_DRIVER=llvmpipe
set LIBGL_ALWAYS_SOFTWARE=1
set GALLIUM_OVERRIDE_CPU_CAPS=sse4.1
set LP_NATIVE_VECTOR_WIDTH=128
if "@N64EMU_SYSTEM_OPENGL@"=="ON" (
    set SDL_OPENGL_LIBRARY=%SystemRoot%\system32\opengl32.dll
    set GALLIUM_DRIVER=
    set LIBGL_ALWAYS_SOFTWARE=
    set GALLIUM_OVERRIDE_CPU_CAPS=
    set LP_NATIVE_VECTOR_WIDTH=
)
set EMUDIR=%SystemRoot%\@N64EMU_EXE_DIR@
set EMU=%SystemRoot%\n64emu\@N64EMU_EXE_PATH@
set ROM=%SystemRoot%\n64emu\roms\@N64EMU_ROM_NAME@
"%S%\dbgprint.exe" N64EMU_BEGIN
if not exist "%EMU%" (
    "%S%\dbgprint.exe" N64EMU_MISSING_EXE %EMU%
    exit /b 2
)
if not exist "%ROM%" (
    "%S%\dbgprint.exe" N64EMU_MISSING_ROM %ROM%
    exit /b 2
)
cd /d "%EMUDIR%"
"%S%\dbgprint.exe" N64EMU_CWD %CD%
"%S%\dbgprint.exe" --process "%EMU% @N64EMU_ARGS@ %ROM% 2>&1"
set RC=%ERRORLEVEL%
"%S%\dbgprint.exe" N64EMU_EXIT %RC%
endlocal & exit /b %RC%
