; Raspberry Pi 5 framebuffer miniport

[Version]
Signature="$Windows NT$"
LayoutFile=layout.inf
Class=Display
ClassGUID={4D36E968-E325-11CE-BFC1-08002BE10318}
Provider=%ReactOS%
DriverVer=06/01/2026,1.0.0.0

[DestinationDirs]
DefaultDestDir=12
Rpi5Vc4.Miniport_CopyFiles=12
Rpi5Vc4.Display_CopyFiles=11

[Manufacturer]
%ReactOS%=ReactOS,NTarm64

[ReactOS.NTarm64]
%Rpi5Vc4.DeviceDesc%=Rpi5Vc4_Install,ACPI\BCM2712
%Rpi5Vc4.DeviceDesc%=Rpi5Vc4_Install,ACPI\BCM2850

[Rpi5Vc4_Install]
CopyFiles=Rpi5Vc4.Miniport_CopyFiles,Rpi5Vc4.Display_CopyFiles
AddReg=Rpi5Vc4_SoftwareSettings

[Rpi5Vc4.Miniport_CopyFiles]
rpi5vc4.sys

[Rpi5Vc4.Display_CopyFiles]
rpi5vc4disp.dll

[Rpi5Vc4_SoftwareSettings]
HKR,,InstalledDisplayDrivers,%REG_MULTI_SZ%,rpi5vc4disp
HKR,,VgaCompatible,%REG_DWORD%,0
HKR,,DefaultSettings.VRefresh,%REG_DWORD%,1
HKR,,DefaultSettings.BitsPerPel,%REG_DWORD%,32
HKR,,DefaultSettings.XResolution,%REG_DWORD%,1024
HKR,,DefaultSettings.YResolution,%REG_DWORD%,768
HKR,,"Device Description",%REG_SZ%,"%Rpi5Vc4.DeviceDesc%"

[Rpi5Vc4_Install.Services]
AddService=rpi5vc4,0x00000002,Rpi5Vc4_Service

[Rpi5Vc4_Service]
DisplayName=%Rpi5Vc4.ServiceDesc%
ServiceType=1
StartType=1
ErrorControl=0
ServiceBinary=%12%\rpi5vc4.sys
LoadOrderGroup=Video Save

[Strings]
ReactOS="ReactOS"
Rpi5Vc4.DeviceDesc="Raspberry Pi 5 VC4 Display"
Rpi5Vc4.ServiceDesc="ReactOS Raspberry Pi 5 VC4 Display Miniport"
REG_MULTI_SZ=0x00010000
REG_DWORD=0x00010001
REG_SZ=0x00000000
