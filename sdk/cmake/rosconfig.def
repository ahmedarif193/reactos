# ReactOS build option definitions for rosconfig (menuconfig).
#
# Parsed by sdk/tools/rosconfig/rosconfig_model.c. The options below mirror the
# CMake cache options declared in sdk/cmake/config.cmake plus the target
# selections consumed directly by configure.sh / configure.cmd ("meta"
# options, which are never emitted to CMake).
#
# Syntax (kconfig-inspired, line based):
#   source "relative/file.def"  include another definition file
#   menu "Title" ... endmenu     nestable submenu; may have depends lines
#   config KEY                   starts an option
#     prompt "Text"              menu label
#     type bool|choice|string    value kind (bool may also hold "auto")
#     value VAL "Label"          one selectable value (choice only)
#     default VAL                default value (bool: y / n / auto)
#     depends KEY=VAL            only active when the dependency holds
#     depends KEY!=VAL           (multiple "depends" lines are ANDed)
#     depends K=V || K2=V2       terms joined by "||" are alternatives
#     meta                       consumed by the configure scripts only
#     var NAME                   CMake variable name (default: KEY)
#     cmaketype BOOL|STRING      CMake cache type (default by option type)
#     help                       indented help text block
#
# Bool options defaulting to "auto" are tri-state: "auto" means "do not
# emit to CMake", which keeps the conditional default logic from
# sdk/cmake/config.cmake (e.g. ENABLE_WOW64 following its conditional
# default) intact.

config ARCH
    prompt "Target architecture"
    type choice
    value amd64 "x86-64"
    value i386  "IA-32 / x86"
    value arm64 "AArch64"
    default amd64
    meta
    help
      CPU architecture to build ReactOS for. This selects the RosBE
      cross toolchain and the output directory name; it is passed to
      CMake by the configure script as -DARCH. A command-line
      -a/--arch (or /arch=) argument overrides this selection for
      that configure run.

source "rosconfig/profiles/profiles.def"

config TOOLCHAIN
    prompt "Compiler toolchain"
    type choice
    value clang "Clang/LLVM (llvm-mingw)"
    value gcc   "GCC (mingw-gcc)"
    value msvc  "MSVC (configure.cmd from a VS prompt only)"
    default clang
    meta
    help
      Which compiler the configure script selects. "clang" uses the
      RosBE llvm-mingw toolchain, "gcc" the RosBE mingw-gcc one.
      "msvc" is only honoured by configure.cmd when run from a
      Visual Studio Developer Command Prompt; configure.sh refuses
      it. Explicit --clang/--gcc (or /clang, /gcc) arguments
      override this selection for that configure run.

config BUILD_TYPE
    prompt "Build type"
    type choice
    value Debug   "Debug"
    value Release "Release"
    default Debug
    meta
    help
      CMAKE_BUILD_TYPE for the configured tree. It controls the default
      DBG value and feeds the WITH_DEBUG_SYMBOLS automatic default.
      A -r/--release (or /r) argument or an explicit
      -DCMAKE_BUILD_TYPE overrides this selection for that run.

menu "Code generation"

    depends TOOLCHAIN!=msvc

config OARCH_AMD64
    prompt "CPU instruction set"
    type choice
    var OARCH
    value k8        "AMD K8"
    value opteron   "AMD Opteron"
    value athlon64  "AMD Athlon 64"
    value athlon-fx "AMD Athlon FX"
    default athlon64
    depends ARCH=amd64
    help
      Oldest CPU the generated code must run on (the OARCH variable,
      passed as -march).

config OARCH_I386
    prompt "CPU instruction set"
    type choice
    var OARCH
    value pentium    "Pentium"
    value pentiumpro "Pentium Pro"
    default pentium
    depends ARCH=i386
    help
      Oldest CPU the generated code must run on (the OARCH variable,
      passed as -march).

config OARCH_ARM64
    prompt "CPU instruction set"
    type choice
    var OARCH
    value armv8-a   "ARMv8.0-A"
    value armv8.1-a "ARMv8.1-A"
    value armv8.2-a "ARMv8.2-A"
    value armv8.3-a "ARMv8.3-A"
    value armv8.4-a "ARMv8.4-A"
    value armv8.5-a "ARMv8.5-A"
    value armv8.6-a "ARMv8.6-A"
    default armv8-a
    depends ARCH=arm64
    help
      Oldest architecture revision the generated code must run on (the
      OARCH variable, passed as -march). Do not raise this unless really
      needed: new designs still ship ARMv8.0 Cortex-A53 cores.

config TUNE
    prompt "Tune for CPU"
    type string
    default generic
    help
      CPU the generated code is scheduled for (the TUNE variable, passed
      as -mtune). This does not change the required instruction set.
      "generic" fits all supported architectures.

config LTCG
    prompt "Link-time optimization (LTO)"
    type bool
    default n
    depends BUILD_TYPE=Release
    help
      Build GCC or Clang Release images with link-time code generation.

config STACK_PROTECTOR
    prompt "Stack protector"
    type bool
    default n
    depends TOOLCHAIN=gcc
    help
      Compile with the GCC stack checker (-fstack-protector-strong).

endmenu

menu "Build options"

config ENABLE_CCACHE
    prompt "Use ccache"
    type bool
    default n
    depends TOOLCHAIN!=msvc
    help
      Wrap the compiler with ccache. Requires ccache on the host.

config SEPARATE_DBG
    prompt "Separate debug symbol files"
    type bool
    default y
    depends TOOLCHAIN!=msvc
    help
      Write debug symbols to separate files instead of keeping them inside
      the binaries.

config ROSSYM_COMPRESSION
    prompt "Compress the embedded .rossym section"
    type bool
    default n
    depends TOOLCHAIN!=msvc
    help
      Store the embedded symbol section compressed with LZNT1 and expand it
      when a module is loaded. The section shrinks to roughly a third of its
      size, about 59 MB across a full image, at the cost of one decompression
      per module at load time. Symbol lookup is unaffected because the
      expanded copy is what gets searched.

config RUNTIME_CHECKS
    prompt "MSVC runtime checks"
    type bool
    default auto
    depends TOOLCHAIN=msvc
    depends BUILD_TYPE=Debug
    help
      Enable MSVC runtime checks (/RTC). "auto" enables them for Debug
      builds; they are incompatible with compiler optimizations.

config _PREFAST_
    prompt "MSVC PREfast analysis"
    type bool
    default n
    depends TOOLCHAIN=msvc
    help
      Run every C compilation through PREfast.

config _VS_ANALYZE_
    prompt "MSVC static analysis (/analyze)"
    type bool
    default n
    depends TOOLCHAIN=msvc
    help
      Compile with /analyze. Takes precedence over PREfast when both are
      enabled.

endmenu

menu "Boot options"

config FREELDR_HTTP_BOOT
    prompt "UEFI HTTP boot"
    type bool
    default n
    depends PROFILE_AMD64=lattepandamu || PROFILE_ARM64=profile_raspberry
    help
      Build the FreeLdr UEFI HTTP boot path: FreeLdr downloads the live
      image over HTTP and boots it as a ramdisk. It becomes the zero-timeout
      default boot entry, and the board's UEFI network drivers are packaged
      onto the boot media.

endmenu

menu "System"

config REACTOS_TARGET_NT
    prompt "Target NT version"
    type choice
    value 0x502 "NT 5.2 (Windows Server 2003)"
    value 0x600 "NT 6.0 (Windows Vista)"
    value 0x601 "NT 6.1 (Windows 7)"
    value 0x602 "NT 6.2 (Windows 8)"
    value 0x603 "NT 6.3 (Windows 8.1)"
    value 0xA00 "NT 10.0 (Windows 10)"
    default 0xA00
    help
      The NT version ReactOS reports and targets (REACTOS_TARGET_NT).
      User-mode DLL exports follow this version through
      DLL_EXPORT_VERSION.

config ENABLE_ALPC
    prompt "ALPC (Advanced Local Procedure Call)"
    type bool
    default y
    help
      Build the ALPC port implementation in place of the classic LPC one.
      Disable to keep the established LPC kernel path.

config ISAPNP_ENABLE
    prompt "ISA Plug and Play support"
    type bool
    default auto
    depends ARCH=i386
    depends PROFILE_I386!=xbox
    help
      Build ISA Plug and Play support. "auto" enables it on i386 PCs.

config ENABLE_ROSV
    prompt "ROSV hypervisor (VMX)"
    type bool
    default n
    depends ARCH=amd64
    help
      Build the ROSV VMX hypervisor driver and its user-mode tools.

endmenu

menu "Graphics"

config REACTOS_GRAPHICS_DRIVER_MODEL
    prompt "Display driver model"
    type choice
    value XPDM "XPDM / VideoPort (legacy)"
    value WDDM "WDDM / dxgkrnl (experimental)"
    default WDDM
    help
      Select the display stack that owns graphics devices in the built image.

      XPDM excludes the DirectX graphics kernel stack and restores the legacy
      VideoPort bind/install path, including the UEFI framebuffer and the
      Raspberry Pi 5 VC4 XPDM miniport.

      WDDM builds dxgkrnl, its memory managers, WDDM miniports and their
      user-mode halves against the Windows 11 24H2 (WDDM 3.2) contract.
      Legacy VGA binaries remain available as recovery components, but WDDM
      owns normal display enumeration.

config MESA_GALLIUM_FROM_SOURCE
    prompt "Mesa Gallium OpenGL driver"
    type bool
    default y
    depends TOOLCHAIN=clang
    depends ARCH=i386 || ARCH=amd64 || ARCH=arm64
    help
      Build and package mesa_gallium.dll with llvm-mingw Clang. AMD64 and
      i386 use softpipe for CPU rendering. ARM64 includes the V3D and VC4
      Raspberry Pi hardware drivers in the same DLL, followed by softpipe.
      No LLVM runtime is needed unless LLVMpipe is enabled below.

config ENABLE_MESA_LLVMPIPE
    prompt "LLVMpipe OpenGL and Lavapipe Vulkan"
    type bool
    default n
    depends MESA_GALLIUM_FROM_SOURCE=y
    depends TOOLCHAIN=clang
    depends ARCH=amd64 || ARCH=arm64
    help
      Replace softpipe with LLVMpipe in mesa_gallium.dll and package the
      Lavapipe Vulkan ICD with the Khronos Vulkan loader. On ARM64 the V3D
      and VC4 hardware drivers are kept and LLVMpipe becomes their CPU
      fallback. LLVM's Windows static libraries and native code-generation
      tools are built automatically; the first enabled build downloads pinned
      sources and needs several GB of free space. opengl32.dll is not
      replaced.

endmenu

menu "Compatibility layers"

config ENABLE_WOW64
    prompt "WoW64 (run 32-bit x86 applications)"
    type bool
    default auto
    depends ARCH=amd64 || ARCH=arm64
    help
      Build the WoW64 subsystem: the support DLLs plus the ntdll and kernel
      paths that run 32-bit x86 applications. "auto" enables it on ARM64.

config ENABLE_FEX_ARM64EC
    prompt "FEX ARM64EC emulator (run x86-64 applications)"
    type bool
    default y
    depends ARCH=arm64
    help
      Build the FEX ARM64EC emulator that runs AMD64 applications on ARM64.
      Its pinned source and build dependencies are part of the checkout;
      missing prerequisites stop configuration while it is enabled.

config ENABLE_FEX_ARM64EC_TEST_PAYLOADS
    prompt "Include local AMD64 FEX diagnostic payloads"
    type bool
    default n
    depends ARCH=arm64
    depends ENABLE_FEX_ARM64EC=y
    help
      Import optional AMD64 diagnostic executables from a neighboring AMD64
      build into the image. Keep this disabled for deterministic release
      and normal development images.

config VALIDATE_COMPAT_BINARIES
    prompt "Validate WoW64 and ARM64EC build outputs"
    type bool
    default auto
    depends ENABLE_FEX_ARM64EC=y || ENABLE_WOW64=y
    help
      Check PE architecture, ARM64EC metadata and ABI-sensitive imports
      after the nested compatibility builds. The compatibility DLLs are
      built and packaged either way. "auto" validates Release builds only.

endmenu

menu "Desktop and applications"

config ENABLE_EXPERIMENTAL_EARLY_SPLASH
    prompt "Early Winlogon background image"
    type bool
    default y
    help
      Show the BlueHorizon PNG as soon as Winlogon creates the interactive
      desktop, stretched across the virtual screen until Userinit has
      prepared the user background and started the shell. Disable to keep
      the classic solid-color startup background and omit the PNG decoder
      path from Winlogon.

config ENABLE_WALLPAPERS
    prompt "Extra wallpapers"
    type bool
    default n
    help
      Add the optional wallpapers module to built images.

config ENABLE_ROSAPPS
    prompt "Extra applications (rosapps)"
    type bool
    default n
    help
      Build the optional applications from modules/rosapps.

endmenu

menu "Kernel debugging"

config KD_DEBUGGER
    prompt "Kernel debugger"
    type choice
    value AUTO     "Automatic (toolchain and build-type default)"
    value NONE     "No interactive kernel debugger"
    value KDBG     "Integrated ReactOS debugger (KDBG)"
    value EXTERNAL "External KD protocol"
    default AUTO
    help
      Select the kernel debugger implementation. "Automatic" uses KDBG for
      GCC/Clang Debug builds, external KD for MSVC Debug builds, and no
      debugger for Release builds.

config KD_DEFAULT_TRANSPORT
    prompt "Default KD transport"
    type choice
    value KDCOM "Serial KD (KDCOM / WinDbg)"
    value KDGDB "GDB remote protocol (KDGDB)"
    default KDCOM
    depends KD_DEBUGGER=EXTERNAL
    help
      Transport installed as the default KDCOM.DLL. The other compatible
      transport remains available through the boot DEBUGPORT option.

endmenu

menu "Testing"

    depends BUILD_TYPE=Debug

config ENABLE_ROSTESTS
    prompt "Test suite and RosAutoTest"
    type bool
    default n
    help
      Build and package the ReactOS test suite, including the RosAutoTest
      runner. Available in Debug builds only.

config ENABLE_ROSAUTOTEST_BOOT_RUN
    prompt "Run the full RosAutoTest suite at boot"
    type bool
    default n
    help
      Build and package the complete test suite, then run it through
      RosAutoTest after desktop startup. The run includes public KMTests.

config ENABLE_KMTEST_BOOT_RUN
    prompt "Run all unattended KMTests at boot"
    type bool
    default n
    help
      Build the kernel-mode test harness even when the test suite is
      disabled, then run its public and hidden unattended tests after
      desktop startup. Interactive, negative self-test and ExPools cases
      remain manual-only.

config ENABLE_CPUBENCH_BOOT_RUN
    prompt "Run CPUbench at boot"
    type bool
    default n
    help
      Run the architecture-neutral CPU benchmark after desktop startup.

config ENABLE_RP1GEM_BENCHMARK
    prompt "Run the RP1 GEM network benchmark at boot"
    type bool
    default n
    depends PROFILE_ARM64=profile_raspberry
    depends FREELDR_HTTP_BOOT=y
    help
      Run one 30-second TCP stream in each direction against the HTTP boot
      host before reporting boot-test completion.

config ENABLE_RPI5_WIFI_BOOT_RUN
    prompt "Run Raspberry Pi 5 Wi-Fi diagnostics at boot"
    type bool
    default n
    depends PROFILE_ARM64=profile_raspberry
    help
      Scan through the native WLAN stack. An optional boot_test_network.cfg
      can name a WIFI_SSID and WIFI_KEY_FILE for connection and throughput
      testing without storing a passphrase in the source tree.

endmenu
