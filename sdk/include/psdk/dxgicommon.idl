import "wtypes.idl";

typedef struct DXGI_RATIONAL
{
    UINT Numerator;
    UINT Denominator;
} DXGI_RATIONAL;

cpp_quote("#define DXGI_STANDARD_MULTISAMPLE_QUALITY_PATTERN 0xffffffff")
cpp_quote("#define DXGI_CENTER_MULTISAMPLE_QUALITY_PATTERN 0xfffffffe")

typedef struct DXGI_SAMPLE_DESC
{
    UINT Count;
    UINT Quality;
} DXGI_SAMPLE_DESC;
