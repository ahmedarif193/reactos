HKLM,"SYSTEM\CurrentControlSet\Services\msgpioclx","Type",0x00010001,1
HKLM,"SYSTEM\CurrentControlSet\Services\spbcx","ErrorControl",0x00010001,1
HKLM,"SYSTEM\CurrentControlSet\Services\spbcx","ImagePath",0x00020000,"system32\drivers\spbcx.sys"
HKLM,"SYSTEM\CurrentControlSet\Services\spbcx","Start",0x00010001,3
HKLM,"SYSTEM\CurrentControlSet\Services\spbcx","Type",0x00010001,1
HKLM,"SYSTEM\CurrentControlSet\Services\sercx2","ErrorControl",0x00010001,1
HKLM,"SYSTEM\CurrentControlSet\Services\sercx2","ImagePath",0x00020000,"system32\drivers\sercx2.sys"
HKLM,"SYSTEM\CurrentControlSet\Services\sercx2","Start",0x00010001,3
HKLM,"SYSTEM\CurrentControlSet\Services\sercx2","Type",0x00010001,1
HKLM,"SYSTEM\CurrentControlSet\Control\Wdf\Kmdf\GPIOClx\Versions\1\1","Service",0x00000000,"msgpioclx"
