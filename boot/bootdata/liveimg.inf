HKLM,"SYSTEM\CurrentControlSet\Enum\Root\UEFIFB\0000","Capabilities",0x00010001,0x00000000
HKLM,"SYSTEM\CurrentControlSet\Enum\Root\UEFIFB\0000\LogConf",,0x00000012
HKLM,"SYSTEM\CurrentControlSet\Enum\Root\UEFIFB\0000\LogConf","BootConfig",0x00000001
HKLM,"SYSTEM\CurrentControlSet\Enum\Root\UEFIFB\0000\LogConf","BasicConfigVector",0x00000001
HKLM,"SYSTEM\CurrentControlSet\Services\uefifb","ImagePath",0x00020000,"system32\drivers\uefifb.sys"
HKLM,"SYSTEM\CurrentControlSet\Services\uefifb","Type",0x00010001,0x00000001
HKLM,"SYSTEM\CurrentControlSet\Services\uefifb","Start",0x00010001,0x00000000
HKLM,"SYSTEM\CurrentControlSet\Services\uefifb","ErrorControl",0x00010001,0x00000001
HKLM,"SYSTEM\CurrentControlSet\Services\uefifb","Group",0x00000000,"Video Save"
HKLM,"SYSTEM\CurrentControlSet\Services\uefifb","DependOnGroup",0x00010000,"Video"
HKLM,"SYSTEM\CurrentControlSet\Services\uefifb","DisplayName",0x00000000,"UEFI Framebuffer Miniport"
; Match Windows-style XPDM device software settings location under Hardware Profiles
HKLM,"SYSTEM\CurrentControlSet\Hardware Profiles\Current\System\CurrentControlSet\Services\uefifb\Device0","InstalledDisplayDrivers",0x00010000,"framebuf"
HKLM,"SYSTEM\CurrentControlSet\Hardware Profiles\Current\System\CurrentControlSet\Services\uefifb\Device0","VgaCompatible",0x00010001,0x00000000
; Also seed the legacy device profile key expected by videoprt for settings copy
HKLM,"SYSTEM\CurrentControlSet\Services\uefifb\Device0",,0x00000012
HKLM,"SYSTEM\CurrentControlSet\Services\uefifb\Device0","InstalledDisplayDrivers",0x00010000,"framebuf"
HKLM,"SYSTEM\CurrentControlSet\Services\uefifb\Device0","VgaCompatible",0x00010001,0x00000000
; Optional default resolution (used by GDI UI; uefifb uses current GOP until runtime switch is implemented)
HKLM,"SYSTEM\CurrentControlSet\Services\uefifb\Device0","DefaultSettings.XResolution",0x00010001,1024
HKLM,"SYSTEM\CurrentControlSet\Services\uefifb\Device0","DefaultSettings.YResolution",0x00010001,768
HKLM,"SYSTEM\CurrentControlSet\Services\uefifb\Device0","DefaultSettings.BitsPerPel",0x00010001,32
; Provide the Services\\uefifb\\Video key that win32k queries to resolve the service
HKLM,"SYSTEM\CurrentControlSet\Services\uefifb\Video","Service",0x00000000,"uefifb"
HKLM,"SYSTEM\CurrentControlSet\Control\Session Manager","BootExecute",0x00010000,""

; Boot straight to desktop without full setup
; For prebuilt image: Use setup -mini on first boot to initialize Administrator account
; and configure autologin, then on subsequent boots go straight to desktop
HKLM,"SYSTEM\Setup","CmdLine",0x00020000,"setup -mini"

; Keep setup marked in-progress so winlogon runs minis-setup once, then it resets the flags
HKLM,"SYSTEM\Setup","SystemSetupInProgress",0x00010001,0x00000001
HKLM,"SYSTEM\Setup","SetupType",0x00010001,0x00000001

; Option 2 (prebuilt image argument): rely on winlogon to bootstrap defaults once.
; TODO: Later replace this with a first-boot wizard that personalizes username, password, locale,
;   timezone, etc.
; For now, default to Administrator/empty password so winlogon can:
;   1. Detect this is a prebuilt image (setup -mini mode)
;   2. Configure the Administrator account and autologin settings below
;   3. Persist everything in the registry, then continue to the desktop
; On subsequent boots, the machine should land directly on the desktop without prompts.

; Autologin configuration - boot straight to desktop without login prompt
; These settings will be applied and persisted on first boot
HKLM,"SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon","AutoAdminLogon",0x00000000,"1"
HKLM,"SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon","ForceAutoLogon",0x00000000,"1"
HKLM,"SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon","IgnoreShiftOverride",0x00000000,"1"
HKLM,"SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon","DefaultDomainName",0x00000000,""
HKLM,"SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon","DefaultUserName",0x00000000,"Administrator"
HKLM,"SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon","DefaultPassword",0x00000000,""
HKLM,"SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon","AutoLogonCount",0x00010001,0xFFFFFFFF
HKLM,"SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon","AutoRestartShell",0x00010001,0x00000001
HKLM,"SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon","DisableCAD",0x00010001,0x00000001

; Mark this as a prebuilt live image for first-boot detection
HKLM,"SOFTWARE\ReactOS\Setup","PrebuiltImage",0x00000000,"LiveIMG"
HKLM,"SOFTWARE\ReactOS\Setup","FirstBootComplete",0x00010001,0x00000000

