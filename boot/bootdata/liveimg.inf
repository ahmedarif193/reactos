[Version]
Signature = "$Windows NT$"

[DelReg]

HKLM,"SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Shell Folders"

[AddReg]

; Default locale for the keyboard layout (French)
HKU,".DEFAULT\Keyboard Layout\Preload","1",0x00000000,"0000040C"

; Toggle keys (Alt+Shift etc.)
HKU,".DEFAULT\Keyboard Layout\Toggle","Hotkey",0x00000000,"1"
HKU,".DEFAULT\Keyboard Layout\Toggle","Language Hotkey",0x00000000,"1"
HKU,".DEFAULT\Keyboard Layout\Toggle","Layout Hotkey",0x00000000,"2"

; Cdrom class driver
HKLM,"SYSTEM\CurrentControlSet\Services\Cdrom","Start",0x00010001,0x00000000

; Reset BootExecute to an empty value: AutoChk should not start
HKLM,"SYSTEM\CurrentControlSet\Enum\Root\UEFIFB","NextInstance",0x00010001,0x00000001
HKLM,"SYSTEM\CurrentControlSet\Enum\Root\UEFIFB","Class",0x00000000,"Display"
HKLM,"SYSTEM\CurrentControlSet\Enum\Root\UEFIFB","ClassGUID",0x00000000,"{4D36E968-E325-11CE-BFC1-08002BE10318}"
HKLM,"SYSTEM\CurrentControlSet\Enum\Root\UEFIFB","DeviceDesc",0x00000000,"UEFI Framebuffer Adapter"
