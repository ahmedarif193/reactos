; PROJECT:     ReactOS Raspberry Pi 5 boot hive
; LICENSE:     GPL-2.0+ (https://spdx.org/licenses/GPL-2.0+)
; FILE:        boot/bootdata/hivesys_rpi5.inf
; PURPOSE:     Raspberry Pi 5 profile-specific boot driver bindings

[AddReg]

; Raspberry Pi 5 VideoCore VII GPU + HVS/PixelValve display pipeline. The UEFI
; firmware exposes it as ACPI device _HID "BCM2712" and _CID "BCM2850".
; Bind either identifier to the configuration-selected rpi5vc4 provider:
; VideoPort for XPDM or dxgkrnl for WDDM 2.0 and later.
HKLM,"SYSTEM\CurrentControlSet\Control\CriticalDeviceDatabase\ACPI#BCM2712","Service",0x00000000,"rpi5vc4"
HKLM,"SYSTEM\CurrentControlSet\Control\CriticalDeviceDatabase\ACPI#BCM2712","ClassGUID",0x00000000,"{4D36E968-E325-11CE-BFC1-08002BE10318}"
HKLM,"SYSTEM\CurrentControlSet\Control\CriticalDeviceDatabase\ACPI#BCM2850","Service",0x00000000,"rpi5vc4"
HKLM,"SYSTEM\CurrentControlSet\Control\CriticalDeviceDatabase\ACPI#BCM2850","ClassGUID",0x00000000,"{4D36E968-E325-11CE-BFC1-08002BE10318}"
