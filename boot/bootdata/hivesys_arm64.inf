; PROJECT:     ReactOS ARM64 boot hive
; LICENSE:     GPL-2.0+ (https://spdx.org/licenses/GPL-2.0+)
; FILE:        boot/bootdata/hivesys_arm64.inf
; PURPOSE:     ARM64 boot-start driver registry entries
; COPYRIGHT:   Copyright 2026 Ahmed ARIF <arif.ing@outlook.com>

[AddReg]

; Raspberry Pi 5 RP1 southbridge bus driver
HKLM,"SYSTEM\CurrentControlSet\Control\CriticalDeviceDatabase\PCI#VEN_1DE4&DEV_0001","Service",0x00000000,"rp1"
HKLM,"SYSTEM\CurrentControlSet\Control\CriticalDeviceDatabase\PCI#VEN_1DE4&DEV_0001","ClassGUID",0x00000000,"{4D36E97D-E325-11CE-BFC1-08002BE10318}"

HKLM,"SYSTEM\CurrentControlSet\Services\rp1","ErrorControl",0x00010001,0x00000001
HKLM,"SYSTEM\CurrentControlSet\Services\rp1","Group",0x00000000,"System Bus Extender"
HKLM,"SYSTEM\CurrentControlSet\Services\rp1","ImagePath",0x00020000,"system32\drivers\rp1.sys"
HKLM,"SYSTEM\CurrentControlSet\Services\rp1","Start",0x00010001,0x00000000
HKLM,"SYSTEM\CurrentControlSet\Services\rp1","Type",0x00010001,0x00000001

; The RP1 Ethernet controller (RP1\GEM) is intentionally not seeded here:
; it is a regular PnP NDIS miniport, installed at runtime from netrp1gem.inf
; so that netcfgx creates NetCfgInstanceId, Linkage, the Connection object
; and the Tcpip interface parameters.
