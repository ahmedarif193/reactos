[Unattend]
Signature = "$ReactOS$"

; Set UnattendSetupEnabled to yes in order to boot the LiveImage immediately to desktop.
; yes - unattend setup enabled
; no - unattend setup disabled
UnattendSetupEnabled = yes

; Set this option to automatically specify language in the language setup.
; See hivesys.inf for available languages.
LocaleID = 409

; Override the default Win8 visual style or select Classic with DefaultThemesOff = yes.
;[Shell]
;DefaultThemesOff = no
;CustomDefaultThemeFile = "%WINDIR%\Resources\Themes\Win8\win8.msstyles"
