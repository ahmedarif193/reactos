; PURPOSE:     PowerPC-specific registry entries

[AddReg]

; The currently supported PReP firmware describes devices through OF, not ACPI.
HKLM,"SYSTEM\CurrentControlSet\Services\acpi","Start",0x00010001,0x00000004

; Native print environment. Keep this synchronized with prtprocenv.h and
; SetupAPI's DIRID_PRINTPROCESSOR directory token.
HKLM,"SYSTEM\CurrentControlSet\Control\Print\Environments\Windows NT PowerPC","Directory",,"ppc"
HKLM,"SYSTEM\CurrentControlSet\Control\Print\Environments\Windows NT PowerPC\Print Processors",,0x00000010
HKLM,"SYSTEM\CurrentControlSet\Control\Print\Environments\Windows NT PowerPC\Print Processors\winprint","Driver",,"winprint.dll"
