+FORCEINLINE
+VOID
+KiSetCurrentIrqlAndGicMask(
+    _In_ KIRQL Irql)
+{
+    ULONG64 Daif;
+
+    __asm__ __volatile__("mrs %0, daif" : "=r"(Daif));
+    __asm__ __volatile__("msr daifset, #2" ::: "memory");
+
+    KiSetCurrentIrql(Irql);
+
+    if (KiHalInitialized)
+    {
+        HalSetGicPriorityMask(Irql);
+    }
+
+    if (!(Daif & 0x80))
+    {
+        __asm__ __volatile__("msr daifclr, #2" ::: "memory");
+    }
 }
 
