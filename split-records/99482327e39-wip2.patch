+#if defined(_M_ARM64) && (defined(__GNUC__) || defined(__clang__))
+FORCEINLINE
+BOOLEAN
+KiDbgStackInThread(
+    _In_opt_ PKTHREAD Thread,
+    _In_ ULONG_PTR StackPointer)
+{
+    return (Thread != NULL) &&
+           (StackPointer >= (ULONG_PTR)Thread->StackLimit) &&
+           (StackPointer < (ULONG_PTR)Thread->StackBase);
+}
+
+FORCEINLINE
+BOOLEAN
+KiDbgStackInDpcStack(
+    _In_opt_ PKPRCB Prcb,
+    _In_opt_ PKTHREAD CurrentThread,
+    _In_ ULONG_PTR StackPointer)
+{
+    ULONG_PTR DpcStackBase;
+    ULONG_PTR DpcStackLimit;
+    ULONG_PTR StackSpan;
+
+    if ((Prcb == NULL) || (Prcb->DpcStack == NULL) || (CurrentThread == NULL))
+    {
+        return FALSE;
+    }
+
+    StackSpan = (ULONG_PTR)CurrentThread->StackBase -
+                (ULONG_PTR)CurrentThread->StackLimit;
+    if ((StackSpan == 0) || (StackSpan > 0x100000))
+    {
+        return FALSE;
+    }
+
+    DpcStackBase = (ULONG_PTR)Prcb->DpcStack;
+    DpcStackLimit = DpcStackBase - StackSpan;
+    return (StackPointer >= DpcStackLimit) && (StackPointer < DpcStackBase);
+}
+
+FORCEINLINE
+LONG
+KiDbgThreadOwnerCpu(
+    _In_opt_ PKTHREAD Thread)
+{
+    LONG Index;
+
+    if (Thread == NULL)
+        return -1;
+
+    for (Index = 0; Index < (LONG)KeNumberProcessors; Index++)
+    {
+        PKPRCB Prcb = KiProcessorBlock[Index];
+        if ((Prcb != NULL) && (Prcb->CurrentThread == Thread))
+            return Index;
+    }
+
+    return -1;
+}
