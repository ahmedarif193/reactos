+typedef struct _FREETYPE_LOCK_TRACE
+{
+    LONG Sequence;
+    PCSTR Operation;
+    ULONG Line;
+    PVOID Caller;
+    PVOID Owner;
+    PVOID CurrentThread;
+    UCHAR Irql;
+    ULONG_PTR StackPointer;
+} FREETYPE_LOCK_TRACE, *PFREETYPE_LOCK_TRACE;
+
+#define FREETYPE_LOCK_TRACE_COUNT 32
+
+static volatile LONG g_FreeTypeLockTraceSequence;
+static FREETYPE_LOCK_TRACE g_FreeTypeLockTrace[FREETYPE_LOCK_TRACE_COUNT];
+
+#if defined(__GNUC__) || defined(__clang__)
+#define FREETYPE_RETURN_ADDRESS() __builtin_return_address(0)
+#else
+#define FREETYPE_RETURN_ADDRESS() _ReturnAddress()
+#endif
+
+#if defined(_M_ARM64) && (defined(__GNUC__) || defined(__clang__))
+#define FREETYPE_READ_STACK_POINTER(_StackPointer) \
+    __asm__ __volatile__("mov %0, sp" : "=r"(_StackPointer))
+#else
+#define FREETYPE_READ_STACK_POINTER(_StackPointer) \
+    do { (_StackPointer) = 0; } while (0)
+#endif
+
+static VOID
+IntRecordFreeTypeLockTrace(
+    _In_ PCSTR Operation,
+    _In_ ULONG Line,
+    _In_opt_ PVOID Caller)
+{
+    LONG Sequence;
+    PFREETYPE_LOCK_TRACE Trace;
+    ULONG_PTR StackPointer;
+
+    FREETYPE_READ_STACK_POINTER(StackPointer);
+
+    Sequence = InterlockedIncrement(&g_FreeTypeLockTraceSequence);
+    Trace = &g_FreeTypeLockTrace[(ULONG)Sequence & (FREETYPE_LOCK_TRACE_COUNT - 1)];
+    Trace->Operation = Operation;
+    Trace->Line = Line;
+    Trace->Caller = Caller;
+    Trace->Owner = g_FreeTypeLock ? g_FreeTypeLock->Owner : NULL;
+    Trace->CurrentThread = KeGetCurrentThread();
+    Trace->Irql = KeGetCurrentIrql();
+    Trace->StackPointer = StackPointer;
+    Trace->Sequence = Sequence;
+}
+
+static VOID
+IntDumpFreeTypeLockTrace(
+    _In_ PCSTR Reason,
+    _In_ ULONG Line,
+    _In_opt_ PVOID Caller)
+{
+    LONG Sequence, Count;
+    ULONG_PTR StackPointer;
+    PFREETYPE_LOCK_TRACE Trace;
+
+    FREETYPE_READ_STACK_POINTER(StackPointer);
+
+    Sequence = g_FreeTypeLockTraceSequence;
+    DPRINT1("FREETYPE_LOCK_%s: line=%lu caller=%p lock=%p owner=%p current=%p "
+            "irql=%u sp=%p seq=%ld\n",
+            Reason,
+            Line,
+            Caller,
+            g_FreeTypeLock,
+            g_FreeTypeLock ? g_FreeTypeLock->Owner : NULL,
+            KeGetCurrentThread(),
+            KeGetCurrentIrql(),
+            (PVOID)StackPointer,
+            Sequence);
+
+    for (Count = 0; Count < FREETYPE_LOCK_TRACE_COUNT; Count++)
+    {
+        Trace = &g_FreeTypeLockTrace[(ULONG)(Sequence - Count) &
+                                     (FREETYPE_LOCK_TRACE_COUNT - 1)];
+        if (Trace->Sequence == 0)
+            continue;
+
+        DPRINT1("FREETYPE_LOCK_TRACE[%ld]: op=%s line=%lu caller=%p "
+                "owner=%p current=%p irql=%u sp=%p\n",
+                Trace->Sequence,
+                Trace->Operation,
+                Trace->Line,
+                Trace->Caller,
+                Trace->Owner,
+                Trace->CurrentThread,
+                Trace->Irql,
+                (PVOID)Trace->StackPointer);
+    }
+}
