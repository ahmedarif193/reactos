 } while (0)
 
 #define IntUnLockFreeType() \
 do { \
     ASSERT_FREETYPE_LOCK_HELD(); \
+    IntRecordFreeTypeLockTrace("UNLOCK", __LINE__, FREETYPE_RETURN_ADDRESS()); \
