+do { \
+    if (g_FreeTypeLock->Owner == KeGetCurrentThread()) \
+        IntDumpFreeTypeLockTrace("REENTER", __LINE__, FREETYPE_RETURN_ADDRESS()); \
+    ASSERT(g_FreeTypeLock->Owner != KeGetCurrentThread()); \
+} while (0)
 
 #define IntLockFreeType() \
 do { \
