+LpcpValidateReplyTarget(IN PETHREAD WakeupThread,
+                        IN PLPCP_PORT_OBJECT Port,
+                        IN ULONG MessageId)
+{
+    LONG ReplyState;
+
+    /* The client must still be waiting for a reply on this LPC port. */
+    if (!LpcpValidateClientPort(WakeupThread, Port))
+    {
+        DPRINT1("LPC reply target is no longer waiting on this port: "
+                "Thread=%p Port=%p MessageId=0x%lx\n",
+                WakeupThread,
+                Port,
+                MessageId);
+        return FALSE;
+    }
+
+    /*
+     * Thread reply semaphores have a limit of one. If the semaphore is
+     * already signaled, another completion would raise
+     * STATUS_SEMAPHORE_LIMIT_EXCEEDED in KeReleaseSemaphore.
+     */
+    ReplyState = KeReadStateSemaphore(&WakeupThread->LpcReplySemaphore);
+    if (ReplyState != 0)
+    {
+        DPRINT1("LPC reply target was already completed: "
+                "Thread=%p Port=%p MessageId=0x%lx State=%ld\n",
+                WakeupThread,
+                Port,
+                MessageId,
+                ReplyState);
+        return FALSE;
+    }
+
+    return TRUE;
+}
