     return TRUE;
 }
 
+#if defined(_M_ARM64)
+static
+BOOLEAN
+CcpArm64EnsureVacbMappedForCopy(
+    _In_ PROS_VACB Vacb,
+    _In_ ULONG Offset,
+    _In_ ULONG Length,
+    _In_ BOOLEAN WriteAccess)
+{
+    ULONG_PTR Va;
+    ULONG_PTR Start;
+    ULONG_PTR End;
+    ULONG FaultCode;
+
+    if (Length == 0)
+    {
+        return TRUE;
+    }
+
+    Start = ((ULONG_PTR)Vacb->BaseAddress + Offset) & ~(ULONG_PTR)(PAGE_SIZE - 1);
+    End = ((ULONG_PTR)Vacb->BaseAddress + Offset + Length + PAGE_SIZE - 1) & ~(ULONG_PTR)(PAGE_SIZE - 1);
+    FaultCode = WriteAccess ? 0x2 : 0x0;
+
+    for (Va = Start; Va < End; Va += PAGE_SIZE)
+    {
+        NTSTATUS Status;
+
+        if (MmIsPagePresent(NULL, (PVOID)Va))
+        {
+            continue;
+        }
+
+        Status = MmAccessFaultEx(FaultCode, (PVOID)Va, KernelMode, NULL, FALSE);
+        if (!NT_SUCCESS(Status) || !MmIsPagePresent(NULL, (PVOID)Va))
+        {
+            return FALSE;
+        }
+    }
+
+    return TRUE;
+}
+#endif
+
