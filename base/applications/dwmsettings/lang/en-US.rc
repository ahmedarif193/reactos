LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDD_SETTINGS DIALOGEX 0, 0, 282, 284
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "DWM Settings"
FONT 9, "MS Shell Dlg"
BEGIN
    LTEXT "Customize desktop window effects. Each change is saved immediately.", -1, 12, 12, 258, 26
    GROUPBOX "GPU window effects", IDC_EFFECTS_GROUP, 12, 42, 258, 110
    AUTOCHECKBOX "&Window animations", IDC_ANIMATIONS, 24, 58, 230, 12
    AUTOCHECKBOX "Window &shadows", IDC_SHADOWS, 24, 76, 230, 12
    AUTOCHECKBOX "Enable &glass look", IDC_ACRYLIC, 24, 94, 230, 12
    AUTOCHECKBOX "Blur window &titles", IDC_BLUR, 36, 112, 218, 12
    AUTOCHECKBOX "Blur window co&ntent", IDC_CONTENT_BLUR, 36, 130, 218, 12
    GROUPBOX "Color scheme", IDC_SCHEME_GROUP, 12, 158, 258, 60
    AUTORADIOBUTTON "&Light", IDC_SCHEME_LIGHT, 24, 176, 100, 12, WS_GROUP
    AUTORADIOBUTTON "&Dark", IDC_SCHEME_DARK, 140, 176, 100, 12
    LTEXT "Select the Windows 8 visual style first to use the glass look and color scheme.", IDC_THEME_NOTE, 24, 194, 238, 18
    LTEXT "", IDC_STATUS, 12, 228, 258, 28
    DEFPUSHBUTTON "Close", IDCANCEL, 210, 262, 60, 14
END

STRINGTABLE
BEGIN
    IDS_ACTIVE "GPU composition is active. Changes apply without restarting DWM."
    IDS_APPLIED "Saved. DWM has reloaded the effects for its next GPU frame. No restart is needed."
    IDS_INACTIVE "Saved. DWM has reloaded the effects for its next software frame. No restart is needed."
    IDS_UNAVAILABLE "Saved. DWM did not acknowledge the change. Restart DWM if the effects do not update."
    IDS_RELOAD_FAILED "Saved, but DWM could not read all preferences. Some effects may still use their previous settings."
    IDS_READ_FAILED "The saved settings could not be read. Error %lu."
    IDS_WRITE_FAILED "The change could not be saved. Error %lu."
    IDS_MISMATCH "Saved, but the active DWM settings differ. Select the option again to retry."
    IDS_DISCONNECTED "DWM is not connected to this panel. Changes will be saved; restart DWM if they do not apply."
    IDS_GPU_UNAVAILABLE "Software composition is active. Changes apply without restarting DWM."
END
