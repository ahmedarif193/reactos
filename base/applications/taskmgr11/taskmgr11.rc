#include <windef.h>
#include <winuser.h>
#include "resource.h"

#define REACTOS_STR_FILE_DESCRIPTION  "ReactOS Task Manager"
#define REACTOS_STR_INTERNAL_NAME     "taskmgr11"
#define REACTOS_STR_ORIGINAL_FILENAME "taskmgr11.exe"
#include <reactos/version.rc>

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
IDI_TASKMGR11 ICON "res/taskmgr11.ico"

1 RT_MANIFEST "res/taskmgr11.exe.manifest"
