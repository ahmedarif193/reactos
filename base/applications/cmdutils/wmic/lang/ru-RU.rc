LANGUAGE LANG_RUSSIAN, SUBLANG_DEFAULT

STRINGTABLE
{
    STRING_COMMAND_NOT_SUPPORTED, "Ошибка: Командная строка не поддерживается\n"
    STRING_ALIAS_NOT_FOUND, "Ошибка: Псевдоним не найден\n"
    STRING_INVALID_QUERY, "Ошибка: Неверный запрос\n"
    STRING_INVALID_PATH, "Ошибка: Неверный синтаксис PATH\n"
    STRING_USAGE, "Supply a command\n"
    STRING_HELP, "Example usage: wmic ALIAS get PROPERTY[,PROPERTY2,...]\n"
}
