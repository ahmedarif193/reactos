 NTAPI
 FsRtlIsNtstatusExpected(IN NTSTATUS NtStatus)
 {
+    /*
+     * "Expected" means a normal filesystem error that FS code can handle in an
+     * exception filter; the four hardware-fault-class codes below are NOT
+     * expected (they indicate a real bug and must propagate to a bugcheck).
+     * This matches Windows semantics and the universal caller idiom
+     * FsRtlIsNtstatusExpected(code) ? EXCEPTION_EXECUTE_HANDLER
+     *                               : EXCEPTION_CONTINUE_SEARCH.
+     */
     return((STATUS_DATATYPE_MISALIGNMENT == NtStatus) ||
            (STATUS_ACCESS_VIOLATION == NtStatus) ||
            (STATUS_ILLEGAL_INSTRUCTION == NtStatus) ||
-           (STATUS_INSTRUCTION_MISALIGNMENT == NtStatus)) ? TRUE : FALSE;
+           (STATUS_INSTRUCTION_MISALIGNMENT == NtStatus)) ? FALSE : TRUE;
 }
 
