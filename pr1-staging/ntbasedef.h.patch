From: ARM64 enablement — enable RotateLeft8/16 helpers on ARM64

The existing RotateLeft8/RotateLeft16/RotateRight8/RotateRight16
macros are AMD64-only because the underlying _rotl8/_rotl16/_rotr8/
_rotr16 intrinsics historically were only available there.

ARM64 has these intrinsics in the mingw-w64 intrinsics shim
(sdk/include/vcruntime/mingw32/intrin_arm64.h), so extend the guard
to enable them for _M_ARM64 too.

---
 sdk/include/xdk/ntbasedef.h | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/sdk/include/xdk/ntbasedef.h b/sdk/include/xdk/ntbasedef.h
--- a/sdk/include/xdk/ntbasedef.h
+++ b/sdk/include/xdk/ntbasedef.h
@@ -792,12 +792,12 @@
 #define RotateRight32 _rotr
 #define RotateRight64 _rotr64

-#if defined(_M_AMD64)
+#if defined(_M_AMD64) || defined(_M_ARM64)
  #define RotateLeft8 _rotl8
  #define RotateLeft16 _rotl16
  #define RotateRight8 _rotr8
  #define RotateRight16 _rotr16
-#endif /* _M_AMD64 */
+#endif /* _M_AMD64 || _M_ARM64 */

 /* C_ASSERT Definition */
 #define C_ASSERT(expr) extern char (*c_assert(void)) [(expr) ? 1 : -1]
