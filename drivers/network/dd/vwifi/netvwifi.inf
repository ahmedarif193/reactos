; ReactOS Virtual Native 802.11 (dot11) Miniport Installation File
; Software-only Native 802.11 miniport; root-enumerated virtual device
; (instantiated at boot via the Enum\Root seed in hivesys.inf).
; Copyright 2026 Ahmed ARIF <arif.ing@outlook.com>

[Version]
Signature   = "$Windows NT$"
Class       = Net
ClassGUID   = {4d36e972-e325-11ce-bfc1-08002be10318}
Provider    = %ReactOS%
DriverVer   = 06/02/2026,1.0.0.0

[DestinationDirs]
DefaultDestDir = 12

[Manufacturer]
%ReactOS% = Models,NTamd64,NTARM64

[Models]
%vwifi.DeviceDesc% = vwifi.ndi, ROOT\NET\VWIFI
%vwifi.DeviceDesc% = vwifi.ndi, ROOT\VWIFI

[Models.NTamd64]
%vwifi.DeviceDesc% = vwifi.ndi, ROOT\NET\VWIFI
%vwifi.DeviceDesc% = vwifi.ndi, ROOT\VWIFI

[Models.NTARM64]
%vwifi.DeviceDesc% = vwifi.ndi, ROOT\NET\VWIFI
%vwifi.DeviceDesc% = vwifi.ndi, ROOT\VWIFI

[vwifi.ndi]
Characteristics = 0x21   ; NCF_VIRTUAL | NCF_HAS_UI
AddReg          = vwifi.reg
CopyFiles       = vwifi.CopyFiles

[vwifi.ndi.Services]
AddService = vwifi, 2, vwifi.Service, vwifi.EventLog

[vwifi.reg]
HKR, Ndi,               Service,    0, "vwifi"
HKR, Ndi\Interfaces,    UpperRange, 0, "ndis5"
HKR, Ndi\Interfaces,    LowerRange, 0, "nativewifi"

[vwifi.CopyFiles]
vwifi.sys

[vwifi.Service]
DisplayName    = %vwifi.ServiceDesc%
ServiceType    = 1      ; SERVICE_KERNEL_DRIVER
StartType      = 3      ; SERVICE_DEMAND_START
ErrorControl   = 1      ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\vwifi.sys
LoadOrderGroup = NDIS

[vwifi.EventLog]
AddReg = vwifi.EventLog.Reg

[vwifi.EventLog.Reg]
HKR, , EventMessageFile, 0x00020000, "%%SystemRoot%%\System32\netevent.dll"
HKR, , TypesSupported,   0x00010001, 7

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
vwifi.sys = 1

[Strings]
ReactOS          = "ReactOS Team"
vwifi.DeviceDesc = "ReactOS Virtual Native 802.11 Adapter"
vwifi.ServiceDesc = "ReactOS Virtual WiFi Driver"
DiskName         = "ReactOS Virtual WiFi Driver Installation Disk"
