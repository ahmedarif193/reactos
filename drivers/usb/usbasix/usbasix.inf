; ASIX AX88772B USB Ethernet driver installation file

[Version]
Signature   = "$Windows NT$"
Class       = Net
ClassGUID   = {4d36e972-e325-11ce-bfc1-08002be10318}
Provider    = %ReactOS%
DriverVer   = 06/03/2026,1.0.0.0

[DestinationDirs]
DefaultDestDir = 12

[Manufacturer]
%ASIX% = ASIXDevices,NTx86,NTamd64

[ASIXDevices.NTx86]
%AX88772B.DeviceDesc% = AX88772B.Install, USB\VID_0B95&PID_772B

[ASIXDevices.NTamd64]
%AX88772B.DeviceDesc% = AX88772B.Install, USB\VID_0B95&PID_772B

[AX88772B.Install]
Characteristics = 0x84
BusType         = 15
AddReg          = AX88772B.Reg
CopyFiles       = AX88772B.CopyFiles

[AX88772B.Install.Services]
AddService = usbasix, 2, AX88772B.Service, AX88772B.EventLog

[AX88772B.Reg]
HKR, Ndi,               Service,    0, "usbasix"
HKR, Ndi\Interfaces,    UpperRange, 0, "ndis5"
HKR, Ndi\Interfaces,    LowerRange, 0, "ethernet"

[AX88772B.CopyFiles]
usbasix.sys

[AX88772B.Service]
DisplayName    = %AX88772B.ServiceDesc%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %12%\usbasix.sys
LoadOrderGroup = NDIS

[AX88772B.EventLog]
AddReg = AX88772B.EventLog.Reg

[AX88772B.EventLog.Reg]
HKR, , EventMessageFile, 0x00020000, "%%SystemRoot%%\System32\netevent.dll"
HKR, , TypesSupported,   0x00010001, 7

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
usbasix.sys = 1

[Strings]
ReactOS              = "ReactOS Team"
ASIX                 = "ASIX Electronics"
AX88772B.DeviceDesc  = "ASIX AX88772B USB 2.0 Ethernet Adapter"
AX88772B.ServiceDesc = "ASIX AX88772B USB Ethernet Driver"
DiskName             = "ASIX AX88772B USB Ethernet Driver Installation Disk"
