[Version]
Signature="$Windows NT$"
Class=SDHost
ClassGuid={a0a588a4-c46f-4b37-b7ea-c82fe89870c6}
Provider=%ProviderString%

[DestinationDirs]
DefaultDestDir=12

[Manufacturer]
%MSFT%=Generic,NTarm64

[Generic.NTarm64]
%rpisdhc.DeviceDesc%=SDHost,ACPI\BCM2855,ACPI\SDHST

[SDHost]
CopyFiles=Drivers_Dir

[Drivers_Dir]
rpisdhc.sys

[SDHost.Services]
AddService=rpisdhc,0x00000002,sdhc_Service_Inst

[sdhc_Service_Inst]
DisplayName=%rpisdhc.DeviceDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\rpisdhc.sys
LoadOrderGroup=System Bus Extender

[Strings]
ProviderString="MS-IOT"
MSFT="Microsoft"
rpisdhc.DeviceDesc="Raspberry Pi SD Host Controller"
