[Version]
Signature="$Windows NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%ProviderString%

[DestinationDirs]
DefaultDestDir=12

[Manufacturer]
%StdMfg%=Standard,NTarm64

[Standard.NTarm64]
%bcmi2c.DeviceDesc%=bcmi2c_Device,ACPI\BCM2841

[bcmi2c_Device.NT]
CopyFiles=Drivers_Dir

[Drivers_Dir]
bcmi2c.sys

[bcmi2c_Device.NT.Services]
AddService=bcmi2c,0x00000002,bcmi2c_Service_Inst

[bcmi2c_Service_Inst]
DisplayName=%bcmi2c.SVCDESC%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\bcmi2c.sys
LoadOrderGroup=Base
Dependencies=spbcx

[Strings]
ProviderString="MS-IOT"
StdMfg="(Standard system devices)"
bcmi2c.DeviceDesc="Broadcom I2C Controller Driver"
bcmi2c.SVCDESC="Broadcom I2C Controller Service"
