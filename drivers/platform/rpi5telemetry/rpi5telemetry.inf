[Version]
Signature = "$Windows NT$"
Class = Sensor
ClassGUID = {5175D334-C371-4806-B3BA-71FD53C9258D}
Provider = %ReactOS%
DriverVer = 08/15/2026,1.0.0.0

[ControlFlags]
ExcludeFromSelect = *

[DestinationDirs]
DefaultDestDir = 12

[Manufacturer]
%ReactOS% = ReactOS,NTarm64

[ReactOS.NTarm64]
%Rpi5Telemetry.DeviceDesc% = Rpi5Telemetry_Inst,ACPI\RPI0005

[Rpi5Telemetry_Inst.NT]
CopyFiles = Rpi5Telemetry_CopyFiles

[Rpi5Telemetry_CopyFiles]
rpi5telemetry.sys

[Rpi5Telemetry_Inst.NT.Services]
AddService = rpi5telemetry,0x00000002,Rpi5Telemetry_Service

[Rpi5Telemetry_Service]
DisplayName = %Rpi5Telemetry.ServiceDesc%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %12%\rpi5telemetry.sys
LoadOrderGroup = Extended Base

[Strings]
ReactOS = "ReactOS Project"
Rpi5Telemetry.DeviceDesc = "Raspberry Pi 5 Firmware Telemetry"
Rpi5Telemetry.ServiceDesc = "ReactOS Raspberry Pi 5 Firmware Telemetry Driver"
