[Version]
Signature = "$Windows NT$"
Class = SecurityDevices
ClassGUID = {D94EE5D8-D189-4994-83D2-F68D7D41B0E6}
Provider = %ReactOS%
DriverVer = 08/04/2026,1.0.0.0

[ControlFlags]
ExcludeFromSelect = *

[DestinationDirs]
DefaultDestDir = 12

[Manufacturer]
%ReactOS% = ReactOS

[ReactOS]
%Tpm2.DeviceDesc% = Tpm2_Inst,ACPI\MSFT0101

[Tpm2_Inst.NT]
CopyFiles = Tpm2_CopyFiles

[Tpm2_CopyFiles]
tpm2.sys

[Tpm2_Inst.NT.Services]
AddService = TPM2,0x00000002,Tpm2_Service

[Tpm2_Service]
DisplayName = %Tpm2.ServiceDesc%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %12%\tpm2.sys
LoadOrderGroup = Extended Base

[Strings]
ReactOS = "ReactOS Project"
Tpm2.DeviceDesc = "Trusted Platform Module 2.0"
Tpm2.ServiceDesc = "ReactOS TPM 2.0 Driver"
