; COPYRIGHT:   Copyright 2026 Ahmed ARIF <arif.ing@outlook.com>
;

[Version]
Signature  = "$Windows NT$"
Class      = DiskDrive
ClassGUID  = {4D36E967-E325-11CE-BFC1-08002BE10318}
Provider   = %ROS%
DriverVer  = 04/21/2026,10.0.0.1
CatalogFile = sffdisk.cat

[SourceDisksNames]
1 = %DiskName%,,,

[SourceDisksFiles]
sffdisk.sys = 1

[DestinationDirs]
DefaultDestDir = 12 ; DIRID_DRIVERS

[Manufacturer]
%GenManufacturer% = SD_Disk_Devices,NT

[SD_Disk_Devices]

[SD_Disk_Devices.NT]
; SD memory cards — hardware IDs generated by sdbus.sys PDOs
%SD_Memory.DeviceDesc%  = sffdisk_Inst, SD\CLASS_MEMORY
%SD_Combo.DeviceDesc%   = sffdisk_Inst, SD\CLASS_COMBO
%MMC_Memory.DeviceDesc% = sffdisk_Inst, SD\CLASS_MMC
%EMMC.DeviceDesc%       = sffdisk_Inst, SD\CLASS_EMMC
; Generic fallback
%SD_Disk.DeviceDesc%    = sffdisk_Inst, GenSFDisk

[ControlFlags]
ExcludeFromSelect = *

[sffdisk_Inst]
CopyFiles = sffdisk_CopyFiles

[sffdisk_CopyFiles]
sffdisk.sys,,,1

[sffdisk_Inst.Services]
AddService = sffdisk, %SPSVCINST_ASSOCSERVICE%, sffdisk_Service_Inst, sffdisk_EventLog_Inst

[sffdisk_Service_Inst]
DisplayName    = %ServiceDesc%
ServiceType    = %SERVICE_KERNEL_DRIVER%
StartType      = %SERVICE_BOOT_START%
ErrorControl   = %SERVICE_ERROR_NORMAL%
ServiceBinary  = %12%\sffdisk.sys
LoadOrderGroup = SCSI Class

[sffdisk_EventLog_Inst]
AddReg = sffdisk_EventLog_AddReg

[sffdisk_EventLog_AddReg]
HKR, , EventMessageFile, %REG_EXPAND_SZ%, "%%SystemRoot%%\System32\IoLogMsg.dll"
HKR, , TypesSupported, %REG_DWORD%, 7

[Strings]
ROS                     = "ReactOS"
DiskName                = "ReactOS SD Flash Disk Driver Installation Disk"
GenManufacturer         = "(Standard SD Storage Devices)"
ServiceDesc             = "SD Flash Disk Driver"
SD_Memory.DeviceDesc    = "SD Memory Card"
SD_Combo.DeviceDesc     = "SD Combo Card"
MMC_Memory.DeviceDesc   = "MMC Memory Card"
EMMC.DeviceDesc         = "eMMC Storage Device"
SD_Disk.DeviceDesc      = "SD/MMC Disk Device"

SPSVCINST_ASSOCSERVICE = 0x00000002
SERVICE_KERNEL_DRIVER  = 1
SERVICE_BOOT_START     = 0
SERVICE_ERROR_NORMAL   = 1
REG_EXPAND_SZ          = 0x00020000
REG_DWORD              = 0x00010001
