; SD Flash Disk class driver — registry entries
[AddReg]
HKLM,"SYSTEM\CurrentControlSet\Services\sffdisk","ErrorControl",0x00010001,0x00000001
HKLM,"SYSTEM\CurrentControlSet\Services\sffdisk","Group",0x00000000,"SCSI Class"
HKLM,"SYSTEM\CurrentControlSet\Services\sffdisk","ImagePath",0x00020000,"system32\drivers\sffdisk.sys"
HKLM,"SYSTEM\CurrentControlSet\Services\sffdisk","Start",0x00010001,0x00000000
HKLM,"SYSTEM\CurrentControlSet\Services\sffdisk","Type",0x00010001,0x00000001
