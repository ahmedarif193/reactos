; PROJECT:     ReactOS boot storage read benchmark driver
; LICENSE:     GPL-2.0-or-later (https://spdx.org/licenses/GPL-2.0-or-later)
; PURPOSE:     Test-only boot service enabled by ENABLE_USB_STORAGE_BOOT_BENCHMARK

[AddReg]
HKLM,"SYSTEM\CurrentControlSet\Services\usbreadbench","ErrorControl",0x00010001,0x00000001
HKLM,"SYSTEM\CurrentControlSet\Services\usbreadbench","Group",0x00000000,"System Bus Extender"
HKLM,"SYSTEM\CurrentControlSet\Services\usbreadbench","ImagePath",0x00020000,"system32\drivers\usbreadbench.sys"
HKLM,"SYSTEM\CurrentControlSet\Services\usbreadbench","Start",0x00010001,0x00000000
HKLM,"SYSTEM\CurrentControlSet\Services\usbreadbench","Type",0x00010001,0x00000001
