; PROJECT:        ReactOS Kernel
; LICENSE:        GNU GPLv2 only as published by the Free Software Foundation
; PURPOSE:        AHCI Miniport Driver INF (SCSIPORT)

[version]
signature="$Windows NT$"
Class=hdc
ClassGuid={4D36E96A-E325-11CE-BFC1-08002BE10318}
Provider=%ROS%

[SourceDisksNames]
1 = %DeviceDesc%,,,

[SourceDisksFiles]
ahciport.sys = 1

[DestinationDirs]
DefaultDestDir = 12 ; DIRID_DRIVERS

[Manufacturer]
%ROS%=AHCIPORT,NTx86,NTamd64

[AHCIPORT.NTx86]
%SATA_AHCI.DeviceDesc%=ahciport_Inst, PCI\CC_010601 ; Standard SATA AHCI Controller

[AHCIPORT.NTamd64]
%SATA_AHCI.DeviceDesc%=ahciport_Inst, PCI\CC_010601 ; Standard SATA AHCI Controller

[ControlFlags]
ExcludeFromSelect = *

[ahciport_Inst]
CopyFiles = ahciport_CopyFiles

[ahciport_Inst.HW]
HKR, "Parameters\PnpInterface", "5", %REG_DWORD%, 0x00000001
HKR, "Parameters", "BusType", %REG_DWORD%, 0x0000000B

[ahciport_Inst.Services]
AddService = ahciport, %SPSVCINST_ASSOCSERVICE%, ahciport_Service_Inst, Miniport_EventLog_Inst

[ahciport_Service_Inst]
DisplayName    = %DeviceDesc%
ServiceType    = %SERVICE_KERNEL_DRIVER%
StartType      = %SERVICE_BOOT_START%
ErrorControl   = %SERVICE_ERROR_CRITICAL%
ServiceBinary  = %12%\ahciport.sys
LoadOrderGroup = SCSI Miniport

[ahciport_CopyFiles]
ahciport.sys,,,1

[Miniport_EventLog_Inst]
AddReg = Miniport_EventLog_AddReg

[Miniport_EventLog_AddReg]
HKR,,EventMessageFile,%REG_EXPAND_SZ%,"%%SystemRoot%%\System32\IoLogMsg.dll"
HKR,,TypesSupported,%REG_DWORD%,7

[Strings]
ROS                     = "ReactOS"
DeviceDesc              = "AHCI SATA Miniport (SCSIPORT)"
SATA_AHCI.DeviceDesc    = "Standard SATA AHCI Controller"

SPSVCINST_ASSOCSERVICE = 0x00000002
SERVICE_KERNEL_DRIVER  = 1
SERVICE_BOOT_START     = 0
SERVICE_ERROR_CRITICAL = 3
REG_EXPAND_SZ          = 0x00020000
REG_DWORD              = 0x00010001

