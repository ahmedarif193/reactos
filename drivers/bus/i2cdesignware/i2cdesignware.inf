; Intel LPSS DesignWare I2C controller driver

[Version]
Signature  = "$Windows NT$"
Class      = System
ClassGUID  = {4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider   = %ReactOS%
DriverVer  = 07/19/2026,1.0.0.0

[DestinationDirs]
DefaultDestDir = 12

[Manufacturer]
%Intel% = Intel,NTamd64

[Intel.NTamd64]
%IntelLPSSI2C.DeviceDesc% = IntelLPSSI2C_Install, PCI\VEN_8086&DEV_7A4C
