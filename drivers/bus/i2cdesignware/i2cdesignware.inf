[IntelLPSSI2C_Install]
CopyFiles = IntelLPSSI2C_CopyFiles

[IntelLPSSI2C_CopyFiles]
i2cdesignware.sys

[IntelLPSSI2C_Install.Services]
AddService = i2cdesignware, 0x00000002, IntelLPSSI2C_Service

[IntelLPSSI2C_Service]
DisplayName    = %IntelLPSSI2C.ServiceDesc%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %12%\i2cdesignware.sys
LoadOrderGroup = System Bus Extender

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
i2cdesignware.sys = 1

[Strings]
ReactOS                    = "ReactOS Project"
Intel                      = "Intel Corporation"
IntelLPSSI2C.DeviceDesc    = "Intel Serial IO I2C Host Controller"
IntelLPSSI2C.ServiceDesc   = "Intel LPSS DesignWare I2C Controller Driver"
DiskName                   = "ReactOS Intel LPSS I2C Driver Installation Disk"
