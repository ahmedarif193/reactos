; WDDM kernel display stack service registration (livecd preinstall)
;
; Registers the three WDDM kernel-mode drivers so they load at boot and
; replace the legacy XPDM display path (uefifb/vga). Load order is driven by
; PE imports (softgpu -> dxgkrnl -> dxgmms1), reinforced by Video groups:
;
;   dxgmms1  WDDM video memory manager      (Video Init) -- dxgkrnl import
;   dxgkrnl  WDDM port driver / D3DKMT      (Video Init) -- softgpu import,
;                                           creates \Device\DxgKrnl + \Device\Video0
;   softgpu  WDDM software miniport         (Video)      -- PnP, binds the
;            firmware framebuffer PnP device (DETECTEDInternal\uefifb) and
;            triggers DxgkAdapterStart -> DxgkDisplayRegister.
;
; win32k loads framebuf.dll (Services\softgpu\Device0\InstalledDisplayDrivers)
; as the GDI display driver; it renders into dxgkrnl's shadow framebuffer which
; the present timer copies to the firmware GOP framebuffer.

[AddReg]
; --- dxgmms1 (video memory manager) ---
HKLM,"SYSTEM\CurrentControlSet\Services\dxgmms1","ErrorControl",0x00010001,0x00000000
HKLM,"SYSTEM\CurrentControlSet\Services\dxgmms1","Group",0x00000000,"Video Init"
HKLM,"SYSTEM\CurrentControlSet\Services\dxgmms1","ImagePath",0x00020000,"system32\drivers\dxgmms1.sys"
HKLM,"SYSTEM\CurrentControlSet\Services\dxgmms1","Start",0x00010001,0x00000001
HKLM,"SYSTEM\CurrentControlSet\Services\dxgmms1","Type",0x00010001,0x00000001
HKLM,"SYSTEM\CurrentControlSet\Services\dxgmms1","Tag",0x00010001,0x00000001

; --- dxgkrnl (WDDM port driver / DirectX graphics kernel) ---
HKLM,"SYSTEM\CurrentControlSet\Services\dxgkrnl","ErrorControl",0x00010001,0x00000000
HKLM,"SYSTEM\CurrentControlSet\Services\dxgkrnl","Group",0x00000000,"Video Init"
HKLM,"SYSTEM\CurrentControlSet\Services\dxgkrnl","ImagePath",0x00020000,"system32\drivers\dxgkrnl.sys"
HKLM,"SYSTEM\CurrentControlSet\Services\dxgkrnl","Start",0x00010001,0x00000001
HKLM,"SYSTEM\CurrentControlSet\Services\dxgkrnl","Type",0x00010001,0x00000001
HKLM,"SYSTEM\CurrentControlSet\Services\dxgkrnl","Tag",0x00010001,0x00000002

; --- softgpu DISABLED (genuine virtio-gpu viogpudo drives the display) ---
; softgpu (the WDDM software miniport) is intentionally NOT registered here.
; The genuine Red Hat virtio-gpu WDDM display-only driver (viogpudo) is the
; display.  Registering softgpu's Root\SOFTGPU device + service in parallel
; created a two-adapter mode conflict (softgpu committed its own mode while
; viogpudo owned the live scanout -> black/garbled desktop), and once softgpu's
; binary is absent its leftover Root\SOFTGPU instance stalls first-boot PnP at
; "Installing devices...".  softgpu stays in the tree as a manual fail-safe but
; is not enumerated or started by default.
