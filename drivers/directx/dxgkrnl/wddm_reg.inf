; WDDM kernel display stack service registration (livecd preinstall)
;
; Registers the three WDDM kernel-mode drivers so they load at boot and
; replace the legacy XPDM display path (uefifb/vga). Load order is driven by
; PE imports (softgpu -> dxgkrnl -> dxgmms1), reinforced by Video groups:
;
;   dxgmms1  WDDM video memory manager      (Video Init) -- dxgkrnl import
;   dxgkrnl  WDDM port driver / D3DKMT      (Video Init) -- softgpu import,
;                                           creates \Device\DxgKrnl + \Device\Video0
;   softgpu  WDDM software miniport         (Video)      -- PnP, binds the
;            firmware framebuffer PnP device (DETECTEDInternal\uefifb) and
;            triggers DxgkAdapterStart -> DxgkDisplayRegister.
;
; win32k loads framebuf.dll (Services\softgpu\Device0\InstalledDisplayDrivers)
; as the GDI display driver; it renders into dxgkrnl's shadow framebuffer which
; the present timer copies to the firmware GOP framebuffer.

[AddReg]
; --- dxgmms1 (video memory manager) ---
HKLM,"SYSTEM\CurrentControlSet\Services\dxgmms1","ErrorControl",0x00010001,0x00000000
HKLM,"SYSTEM\CurrentControlSet\Services\dxgmms1","Group",0x00000000,"Video Init"
HKLM,"SYSTEM\CurrentControlSet\Services\dxgmms1","ImagePath",0x00020000,"system32\drivers\dxgmms1.sys"
HKLM,"SYSTEM\CurrentControlSet\Services\dxgmms1","Start",0x00010001,0x00000001
HKLM,"SYSTEM\CurrentControlSet\Services\dxgmms1","Type",0x00010001,0x00000001
HKLM,"SYSTEM\CurrentControlSet\Services\dxgmms1","Tag",0x00010001,0x00000001

; --- dxgkrnl (WDDM port driver / DirectX graphics kernel) ---
HKLM,"SYSTEM\CurrentControlSet\Services\dxgkrnl","ErrorControl",0x00010001,0x00000000
HKLM,"SYSTEM\CurrentControlSet\Services\dxgkrnl","Group",0x00000000,"Video Init"
HKLM,"SYSTEM\CurrentControlSet\Services\dxgkrnl","ImagePath",0x00020000,"system32\drivers\dxgkrnl.sys"
HKLM,"SYSTEM\CurrentControlSet\Services\dxgkrnl","Start",0x00010001,0x00000001
HKLM,"SYSTEM\CurrentControlSet\Services\dxgkrnl","Type",0x00010001,0x00000001
HKLM,"SYSTEM\CurrentControlSet\Services\dxgkrnl","Tag",0x00010001,0x00000002

; --- softgpu (WDDM software miniport, PnP) ---
HKLM,"SYSTEM\CurrentControlSet\Services\softgpu","ErrorControl",0x00010001,0x00000000
HKLM,"SYSTEM\CurrentControlSet\Services\softgpu","Group",0x00000000,"Video"
HKLM,"SYSTEM\CurrentControlSet\Services\softgpu","ImagePath",0x00020000,"system32\drivers\softgpu.sys"
HKLM,"SYSTEM\CurrentControlSet\Services\softgpu","Start",0x00010001,0x00000001
HKLM,"SYSTEM\CurrentControlSet\Services\softgpu","Type",0x00010001,0x00000001
HKLM,"SYSTEM\CurrentControlSet\Services\softgpu","Tag",0x00010001,0x00000003
HKLM,"SYSTEM\CurrentControlSet\Services\softgpu\Video","Service",0x00000000,"softgpu"

HKLM,"SYSTEM\CurrentControlSet\Services\softgpu\Device0","InstalledDisplayDrivers",0x00010000,"framebuf"
HKLM,"SYSTEM\CurrentControlSet\Services\softgpu\Device0","DefaultSettings.VRefresh",0x00010001,0x00000001
HKLM,"SYSTEM\CurrentControlSet\Services\softgpu\Device0","DefaultSettings.BitsPerPel",0x00010001,0x00000020
HKLM,"SYSTEM\CurrentControlSet\Services\softgpu\Device0","DefaultSettings.XResolution",0x00010001,0x00000400
HKLM,"SYSTEM\CurrentControlSet\Services\softgpu\Device0","DefaultSettings.YResolution",0x00010001,0x00000300
HKLM,"SYSTEM\CurrentControlSet\Services\softgpu\Device0","Device Description",0x00000000,"ReactOS WDDM Software GPU"
HKLM,"SYSTEM\CurrentControlSet\Services\softgpu\Device0","VgaCompatible",0x00010001,0x00000000

; --- Root-enumerated PnP device instance for softgpu ---
; softgpu is a PnP WDDM miniport (DxgkInitialize installs an AddDevice handler),
; so it needs a PDO to bind to. Preregister a root device so the PnP root bus
; (ntoskrnl pnproot.c enumerates SYSTEM\CurrentControlSet\Enum\Root) creates the
; PDO and, because Service+ClassGUID are already set, starts softgpu at boot ->
; AddDevice -> DxgkAdapterStart -> DxgkDisplayRegister (\Device\Video0 +
; HARDWARE\DEVICEMAP\VIDEO) before win32k's display init runs.
HKLM,"SYSTEM\CurrentControlSet\Enum\Root\SOFTGPU\0000","DeviceDesc",0x00000000,"ReactOS WDDM Software GPU"
HKLM,"SYSTEM\CurrentControlSet\Enum\Root\SOFTGPU\0000","HardwareID",0x00010000,"ROOT\SOFTGPU"
HKLM,"SYSTEM\CurrentControlSet\Enum\Root\SOFTGPU\0000","Service",0x00000000,"softgpu"
HKLM,"SYSTEM\CurrentControlSet\Enum\Root\SOFTGPU\0000","Class",0x00000000,"Display"
HKLM,"SYSTEM\CurrentControlSet\Enum\Root\SOFTGPU\0000","ClassGUID",0x00000000,"{4D36E968-E325-11CE-BFC1-08002BE10318}"
HKLM,"SYSTEM\CurrentControlSet\Enum\Root\SOFTGPU\0000","ConfigFlags",0x00010001,0x00000000
