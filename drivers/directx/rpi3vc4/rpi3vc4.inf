[Version]
Signature="$Windows NT$"
LayoutFile=layout.inf
Class=Display
ClassGUID={4D36E968-E325-11CE-BFC1-08002BE10318}
Provider=%ReactOS%
DriverVer=08/31/2026,2.0.0.0

[DestinationDirs]
DefaultDestDir=12
Rpi3Vc4.Miniport_CopyFiles=12

[Manufacturer]
%ReactOS%=ReactOS,NTarm64

[ReactOS.NTarm64]
%Rpi3Vc4.DeviceDesc%=Rpi3Vc4_Install,ACPI\BCM2850

[Rpi3Vc4_Install]
CopyFiles=Rpi3Vc4.Miniport_CopyFiles
AddReg=Rpi3Vc4_SoftwareSettings

[Rpi3Vc4.Miniport_CopyFiles]
rpi3vc4.sys

[Rpi3Vc4_SoftwareSettings]
HKR,,InstalledDisplayDrivers,%REG_MULTI_SZ%,framebuf
HKR,,VgaCompatible,%REG_DWORD%,0
HKR,,OpenGLDriverName,%REG_SZ%,rpi3vc4ogl.dll
HKR,,OpenGLVersion,%REG_DWORD%,1
HKR,,OpenGLFlags,%REG_DWORD%,0
HKR,,DefaultSettings.VRefresh,%REG_DWORD%,1
HKR,,DefaultSettings.BitsPerPel,%REG_DWORD%,32
HKR,,DefaultSettings.XResolution,%REG_DWORD%,1024
HKR,,DefaultSettings.YResolution,%REG_DWORD%,768
HKR,,"Device Description",%REG_SZ%,"%Rpi3Vc4.DeviceDesc%"

[Rpi3Vc4_Install.Services]
AddService=rpi3vc4,0x00000002,Rpi3Vc4_Service

[Rpi3Vc4_Service]
DisplayName=%Rpi3Vc4.ServiceDesc%
ServiceType=1
StartType=3
ErrorControl=0
ServiceBinary=%12%\rpi3vc4.sys
LoadOrderGroup=Video

[Strings]
ReactOS="ReactOS"
Rpi3Vc4.DeviceDesc="Raspberry Pi 3 VC4 Display (WDDM)"
Rpi3Vc4.ServiceDesc="ReactOS Raspberry Pi 3 VC4 WDDM Driver"
REG_MULTI_SZ=0x00010000
REG_DWORD=0x00010001
REG_SZ=0x00000000
