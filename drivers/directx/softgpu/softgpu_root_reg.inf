; ReactOS Basic Display fallback (live-image preinstall)

[AddReg]
HKLM,"SYSTEM\CurrentControlSet\Services\BasicDisplay","ErrorControl",0x00010001,0x00000000
HKLM,"SYSTEM\CurrentControlSet\Services\BasicDisplay","Group",0x00000000,"Video"
HKLM,"SYSTEM\CurrentControlSet\Services\BasicDisplay","ImagePath",0x00020000,"system32\drivers\BasicDisplay.sys"
HKLM,"SYSTEM\CurrentControlSet\Services\BasicDisplay","Start",0x00010001,0x00000001
HKLM,"SYSTEM\CurrentControlSet\Services\BasicDisplay","Type",0x00010001,0x00000001
HKLM,"SYSTEM\CurrentControlSet\Services\BasicDisplay","Tag",0x00010001,0x00000003
HKLM,"SYSTEM\CurrentControlSet\Services\BasicDisplay","UserModeDriverName",0x00010000,"softgpuum.dll","softgpuum.dll","softgpuum.dll","softgpuum.dll"
HKLM,"SYSTEM\CurrentControlSet\Services\BasicDisplay","UserModeDriverNameWow",0x00010000,"softgpuum.dll","softgpuum.dll","softgpuum.dll","softgpuum.dll"
HKLM,"SYSTEM\CurrentControlSet\Services\BasicDisplay\Video","Service",0x00000000,"BasicDisplay"
HKLM,"SYSTEM\CurrentControlSet\Services\BasicDisplay\Device0","InstalledDisplayDrivers",0x00010000,"framebuf"
HKLM,"SYSTEM\CurrentControlSet\Services\BasicDisplay\Device0","DefaultSettings.VRefresh",0x00010001,0x00000001
HKLM,"SYSTEM\CurrentControlSet\Services\BasicDisplay\Device0","DefaultSettings.BitsPerPel",0x00010001,0x00000020
HKLM,"SYSTEM\CurrentControlSet\Services\BasicDisplay\Device0","DefaultSettings.XResolution",0x00010001,0x00000400
HKLM,"SYSTEM\CurrentControlSet\Services\BasicDisplay\Device0","DefaultSettings.YResolution",0x00010001,0x00000300
HKLM,"SYSTEM\CurrentControlSet\Services\BasicDisplay\Device0","Device Description",0x00000000,"ReactOS Basic Display Adapter"
HKLM,"SYSTEM\CurrentControlSet\Services\BasicDisplay\Device0","VgaCompatible",0x00010001,0x00000000

HKLM,"SYSTEM\CurrentControlSet\Enum\Root\BASICDISPLAY\0000","DeviceDesc",0x00000000,"ReactOS Basic Display Adapter"
HKLM,"SYSTEM\CurrentControlSet\Enum\Root\BASICDISPLAY\0000","HardwareID",0x00010000,"ROOT\BASICDISPLAY"
HKLM,"SYSTEM\CurrentControlSet\Enum\Root\BASICDISPLAY\0000","Service",0x00000000,"BasicDisplay"
HKLM,"SYSTEM\CurrentControlSet\Enum\Root\BASICDISPLAY\0000","Class",0x00000000,"Display"
HKLM,"SYSTEM\CurrentControlSet\Enum\Root\BASICDISPLAY\0000","ClassGUID",0x00000000,"{4D36E968-E325-11CE-BFC1-08002BE10318}"
HKLM,"SYSTEM\CurrentControlSet\Enum\Root\BASICDISPLAY\0000","Driver",0x00000000,"{4D36E968-E325-11CE-BFC1-08002BE10318}\BasicDisplay"
HKLM,"SYSTEM\CurrentControlSet\Enum\Root\BASICDISPLAY\0000","ConfigFlags",0x00010001,0x00000000

; Synthetic root fallback uses a named software key so it cannot consume the
; numeric Control\Class instance reserved by a preinstalled physical adapter.
HKLM,"SYSTEM\CurrentControlSet\Control\Class\{4D36E968-E325-11CE-BFC1-08002BE10318}\BasicDisplay","InstalledDisplayDrivers",0x00010000,"framebuf"
HKLM,"SYSTEM\CurrentControlSet\Control\Class\{4D36E968-E325-11CE-BFC1-08002BE10318}\BasicDisplay","Device Description",0x00000000,"ReactOS Basic Display Adapter"
HKLM,"SYSTEM\CurrentControlSet\Control\Class\{4D36E968-E325-11CE-BFC1-08002BE10318}\BasicDisplay","VgaCompatible",0x00010001,0x00000000
