[Version]
Signature="$ReactOS$"
Class=Processor
ClassGuid={50127DC3-0F36-415E-A6CC-4CB3BE910B65}
Provider=%ReactOS%
DriverVer=07/01/2025,0.0.1.0

[Manufacturer]
%ReactOS%=ProcessorMfg,NTamd64

[ProcessorMfg.NTamd64]
%AcpiProc.DeviceDesc%=AcpiProc_Inst,ACPI\GenuineIntel_-_EM64T_Family_15_Model_107\_0
%AcpiProc.DeviceDesc%=AcpiProc_Inst,ACPI\GenuineIntel_*
%AcpiProc.DeviceDesc%=AcpiProc_Inst,ACPI\AuthenticAMD_*
%AcpiProc.DeviceDesc%=AcpiProc_Inst,ACPI\ACPI0007
%AcpiProc.DeviceDesc%=AcpiProc_Inst,ACPI\MSFT0007

[AcpiProc_Inst.NT]
CopyFiles=acpiproc.CopyFiles

[AcpiProc_Inst.NT.Services]
AddService=acpiproc,0x00000002,acpiproc_Service

[acpiproc_Service]
DisplayName=%AcpiProc.SvcDesc%
ServiceType=1
StartType=1
ErrorControl=1
LoadOrderGroup=Base
ServiceBinary=%12%\acpiproc.sys

[DestinationDirs]
acpiproc.CopyFiles=12

[acpiproc.CopyFiles]
acpiproc.sys

[SourceDisksNames]
1=%ReactOS%,,,

[SourceDisksFiles]
acpiproc.sys=1

[Strings]
ReactOS="Ahmed ARIF <arif.ing@outlook.com>"
AcpiProc.DeviceDesc="ACPI Processor Driver"
AcpiProc.SvcDesc="ACPI Processor Driver"
