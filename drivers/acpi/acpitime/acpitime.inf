[Version]
Signature = "$Windows NT$"
Class = System
ClassGUID = {4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider = %ReactOS%
DriverVer = 08/04/2026,1.0.0.0

[ControlFlags]
ExcludeFromSelect = *

[DestinationDirs]
DefaultDestDir = 12

[Manufacturer]
%ReactOS% = ReactOS

[ReactOS]
%AcpiTime.DeviceDesc% = AcpiTime_Inst,ACPI\ACPI000E

[AcpiTime_Inst.NT]
CopyFiles = AcpiTime_CopyFiles

[AcpiTime_CopyFiles]
acpitime.sys

[AcpiTime_Inst.NT.Services]
AddService = ACPITIME,0x00000002,AcpiTime_Service

[AcpiTime_Service]
DisplayName = %AcpiTime.ServiceDesc%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %12%\acpitime.sys
LoadOrderGroup = Extended Base

[Strings]
ReactOS = "ReactOS Project"
AcpiTime.DeviceDesc = "ACPI Wake Alarm"
AcpiTime.ServiceDesc = "ReactOS ACPI Time and Alarm Driver"
